{
  "name": "@webship.co/workspace-graph",
  "version": "1.0.12",
  "description": "The knowledge graphs for Webship Workspace: the graphs/ workspace as a plugin, the Graph menu on every project row (build with graphify, open, report, download, MCP, delete) and the Obsidian vault made from a graph (build, read, map, download), with the /graph and /obsidian pages; with its AI items (an agent, a skill, a command and a prompt), each placed in the folder of its kind.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-graph.git"
  },
  "files": [
    "README.md",
    "ai",
    "commands",
    "config",
    "dist/src",
    "docs",
    "features",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "graph",
    "label": "Graphs",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        "python3"
      ]
    },
    "suggests": {
      "plugins": [
        [
          "dev",
          "test",
          "sandboxes",
          "demos",
          "projects",
          "products",
          "drupal-modules",
          "drupal-themes",
          "drupal-recipes",
          "drupal-profiles",
          "drupal-site-templates",
          "libraries"
        ]
      ],
      "commands": [
        {
          "command": "graphify",
          "hint": "cmd-tools-graphify.sh installs it for you with uv or pipx when it is missing"
        },
        [
          "uv",
          "pipx"
        ]
      ]
    },
    "workspace": {
      "key": "graphs",
      "settingsTemplate": "config/workspace.graphs.settings.yml",
      "files": [
        "commands/cmd-tools-graphs.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/graphs-mapper.md"
      ],
      "skills": [
        "ai/skills/graphs-workflow"
      ],
      "commands": [
        "ai/commands/graphs-query.md"
      ],
      "prompts": [
        "ai/prompts/graphs-map-a-project.md"
      ]
    },
    "features": [
      "features/graph.feature"
    ],
    "typeActions": {
      "graphify": [
        "sites",
        "code"
      ]
    },
    "commands": {
      "types": [
        "sites",
        "code"
      ],
      "files": [
        "commands/cmd-tools-graphify.sh",
        "commands/cmd-tools-obsidian.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-graphify.sh",
        "scripts/functions/fun-graphs.sh",
        "scripts/functions/fun-obsidian.sh"
      ],
      "args": [
        "scripts/args/arg-graphify.sh",
        "scripts/args/arg-graphs.sh",
        "scripts/args/arg-obsidian.sh"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
